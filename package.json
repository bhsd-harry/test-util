{
	"name": "@bhsd/test-util",
	"version": "3.1.1",
	"homepage": "https://github.com/bhsd-harry/test-util#readme",
	"bugs": {
		"url": "https://github.com/bhsd-harry/test-util/issues"
	},
	"license": "GPL-3.0-or-later",
	"author": "Bhsd",
	"files": [
		"/dist/",
		"/parserTests.json"
	],
	"bin": {
		"testUtil": "./dist/bin.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./mocha": "./dist/mocha.js",
		"./parser": "./dist/parser.js"
	},
	"type": "module",
	"scripts": {
		"ls": "npm i --package-lock-only && npm ls --package-lock-only --all --omit=dev",
		"prepublishOnly": "npm run build",
		"build": "tsc && node build.cjs && cp ../wikiparser-node/test/parserTests.json .",
		"lint:ts": "tsc --noEmit && eslint --cache .",
		"lint": "npm run lint:ts"
	},
	"dependencies": {
		"@bhsd/nodejs": "^1.2.1",
		"@types/mocha": "^10.0.10"
	},
	"devDependencies": {
		"@bhsd/code-standard": "^4.1.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.8.1",
		"typescript": "^6.0.3",
		"wikiparser-node": "^1.46.2"
	},
	"engines": {
		"node": "^20.19.0 || ^22.13.0 || >=24.11.0"
	}
}
